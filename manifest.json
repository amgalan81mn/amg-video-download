{
  "manifest_version": 3,
  "name": "Amg-Video-Download",
  "version": "1.1.0",
  "description": "Вэб дээрх видео, аудиог MP4 / MP3 хэлбэрээр татах. Баруун товч, линк, олон медиа сонгох.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Amg-Video-Download",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "webRequest",
    "storage",
    "scripting",
    "tabs",
    "activeTab",
    "notifications",
    "downloads.open"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
